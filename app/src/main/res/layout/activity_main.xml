<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calcBackground"
    android:fitsSystemWindows="false"
    tools:context=".ui.MainActivity">

    <!-- Header pushed down to avoid status bar overlap -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calc_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="56dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/calc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/calcTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/calc_title_underline"
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@color/calcAccent"
            app:layout_constraintStart_toStartOf="@id/calc_title"
            app:layout_constraintTop_toBottomOf="@id/calc_title" />

        <ImageButton
            android:id="@+id/calc_btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/calc_settings_title"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_tinted_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/calcTextSecondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Display area: formula (top, small) + current value (bottom, large) -->
    <LinearLayout
        android:id="@+id/calc_display_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/calc_keypad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calc_header">

        <TextView
            android:id="@+id/calc_formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/calcTextSecondary"
            android:textSize="22sp"
            tools:text="8 -" />

        <TextView
            android:id="@+id/calc_current"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="32sp"
            android:autoSizeMaxTextSize="64sp"
            android:autoSizeStepGranularity="2sp"
            android:gravity="end|center_vertical"
            android:text="0"
            android:textColor="@color/calcTextPrimary"
            android:textStyle="bold"
            tools:text="3" />

    </LinearLayout>

    <!-- Keypad -->
    <GridLayout
        android:id="@+id/calc_keypad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:columnCount="4"
        android:rowCount="6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1: Memory -->
        <Button
            android:id="@+id/btn_mc"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_mc" />

        <Button
            android:id="@+id/btn_mp"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_mp" />

        <Button
            android:id="@+id/btn_mm"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_mm" />

        <Button
            android:id="@+id/btn_mr"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_mr" />

        <!-- Row 2: Functions -->
        <Button
            android:id="@+id/btn_ac"
            style="@style/CalcButtonTextRed"
            android:text="@string/calc_ac" />

        <ImageButton
            android:id="@+id/btn_backspace"
            style="@style/CalcButtonImageRed"
            android:contentDescription="@string/calc_backspace"
            android:src="@drawable/ic_backspace_24dp" />

        <Button
            android:id="@+id/btn_plus_minus"
            style="@style/CalcButtonTextRed"
            android:text="@string/calc_plus_minus" />

        <Button
            android:id="@+id/btn_divide"
            style="@style/CalcButtonOperator"
            android:text="@string/calc_op_divide" />

        <!-- Row 3: 7 8 9 × -->
        <Button
            android:id="@+id/btn_7"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_7" />

        <Button
            android:id="@+id/btn_8"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_8" />

        <Button
            android:id="@+id/btn_9"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_9" />

        <Button
            android:id="@+id/btn_multiply"
            style="@style/CalcButtonOperator"
            android:text="@string/calc_op_multiply" />

        <!-- Row 4: 4 5 6 - -->
        <Button
            android:id="@+id/btn_4"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_4" />

        <Button
            android:id="@+id/btn_5"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_5" />

        <Button
            android:id="@+id/btn_6"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_6" />

        <Button
            android:id="@+id/btn_minus"
            style="@style/CalcButtonOperator"
            android:text="@string/calc_op_minus" />

        <!-- Row 5: 1 2 3 + -->
        <Button
            android:id="@+id/btn_1"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_1" />

        <Button
            android:id="@+id/btn_2"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_2" />

        <Button
            android:id="@+id/btn_3"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_3" />

        <Button
            android:id="@+id/btn_plus"
            style="@style/CalcButtonOperator"
            android:text="@string/calc_op_plus" />

        <!-- Row 6: % 0 . = -->
        <Button
            android:id="@+id/btn_percent"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_percent" />

        <Button
            android:id="@+id/btn_0"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_0" />

        <Button
            android:id="@+id/btn_dot"
            style="@style/CalcButtonNormal"
            android:text="@string/calc_dot" />

        <Button
            android:id="@+id/btn_equals"
            style="@style/CalcButtonEquals"
            android:text="@string/calc_op_equals" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
